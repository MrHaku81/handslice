# Build outputs
/build/
/app/build/
/engine/build/
/engine/deps-build/
*.apk
*.aab
*.so
*.o
*.a

# NDK / native
/engine/obj/
/engine/.cxx/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Android / Gradle
.gradle/
local.properties
*.iml
/.idea/
captures/

# Python (server/)
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
*.swp
*~

# Sliced output / test artifacts
*.gcode
/tmp/
/scratch/
/server/jobs/
/logs/
/engine/test/out-*/
/engine/test/*.log
/engine/build-logs/
/engine/build-deps-*.log
/engine/build-cli-*.log
/engine/build-headless-*.log

# Reference G-Code bleibt eingecheckt (siehe engine/test/reference/)
!/engine/test/reference/*.gcode

# Large bundled engine binaries (über Release-Assets verteilen)
/engine/bin/*-arm64
/engine/bin/*-x86
# Side-Car-Hash-Dateien, die die Build-Scripts neben die Binaries schreiben
/engine/bin/*.commit
# Schema-Join-Zwischendateien (aus engine/scripts/*.py); eingecheckt
# werden nur die Scripts selbst und ggf. finale Artefakte.
/engine/out/

# Referenz-AppImage und sonstige externe Build-Artefakte (nicht einchecken)
/engine/reference/
.env

# Claude Code lokale Settings (geteilte Projekt-Settings in .claude/ bleiben
# eincheckbar, falls spaeter angelegt – nur der User-lokale Override wird
# ignoriert)
.claude/settings.local.json
/local-test/
