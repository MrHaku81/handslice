<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only opt-in for Flutter GPU (used by flutter_scene). Needed
         for the hidden plate-view benchmark screen in Settings. Kept out
         of the release manifest intentionally: whether Flutter GPU goes
         into production is still open and depends on the benchmark
         results. See docs/plate-view-benchmark.md. -->
    <application>
        <meta-data
            android:name="io.flutter.embedding.android.EnableFlutterGPU"
            android:value="true" />
    </application>
</manifest>
